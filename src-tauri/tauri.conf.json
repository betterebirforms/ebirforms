{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eBIRForms",
  "version": "0.1.4",
  "identifier": "ph.advo.ebirforms",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:10900",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGN0UwQ0RDNEI3QzQwNDkKUldSSlFIeEwzQXgrSDZ4d3gxSkh0bVZzUXlwT0E1VkJWUmVNc3Y1UjI1VFMvb2xvZGJlM1RCNEwK",
      "endpoints": [
        "https://github.com/betterebirforms/ebirforms/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
